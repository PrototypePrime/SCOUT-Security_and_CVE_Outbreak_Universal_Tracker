# ============================================
# SCOUT Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database (PostgreSQL)
# ---------------------
POSTGRES_USER=scout
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=scout

# Security
# --------
# SECRET_KEY is the master password that secures all user logins in SCOUT.
# When you log in, SCOUT creates a login token (like a wristband at a concert)
# so you don't have to re-enter your password on every page.
# This key is used to create and verify those tokens.
#
# WHY IT MATTERS:
#   - Without it, anyone could fake a login token and access your dashboard
#   - It must be unique to YOUR installation
#   - Keep it secret — if someone knows it, they can forge logins
#
# HOW TO GENERATE:
#   Linux/Mac: openssl rand -hex 32
#   Or just type any random 64-character string below
SECRET_KEY=change_this_to_a_long_random_string

# AI Configuration
# ----------------
# Preference: "local" (external Ollama) or "cloud" (default)
AI_MODEL_PREFERENCE=cloud

# Cloud API Settings (default AI)
SCOUT_CLOUD_API_KEY=your-api-key
SCOUT_CLOUD_API_URL=https://api.example.com/v1/chat/completions

# External Ollama Settings (optional, for local AI)
# Docker: http://host.docker.internal:11434
# Local:  http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Email Notifications (Outlook SMTP)
# -----------------------------------
SCOUT_EMAIL=
SCOUT_EMAIL_PASSWORD=

# Web Push VAPID Keys
# -------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
